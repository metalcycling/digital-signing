# Demo creates local records only; switch to google after connecting.
SIGNING_MODE=demo
SIGNING_TEMPLATE_FOLDER_ID=11K4hQcCiXVSq7GF2OEXQfYZ3ee9oXUFD
# Required in Google mode: a separate existing Google Drive folder.
SIGNING_CONTRACTS_FOLDER_ID=
# Runtime data defaults outside Dropbox: ~/.local/share/digital-signing
# SIGNING_DATA_DIR=/absolute/path/to/private/runtime-data

# Gmail sending is opt-in. Run uv run python -m digital_signing.setup_gmail first.
SIGNING_EMAIL_MODE=local
SIGNING_EMAIL_BASE_URL=http://localhost:8000

# Optional: vendor alerts default to the configured Gmail sender address.
# SIGNING_VENDOR_EMAIL=vendor@example.com

# Calendar date used for automatic signer dates.
SIGNING_SIGNING_TIMEZONE=America/New_York

# Staff authentication is required by default. Google login credentials and the
# approved-user list live under SIGNING_DATA_DIR, separate from the Drive token.
SIGNING_AUTH_MODE=google
SIGNING_APP_BASE_URL=http://localhost:8000
SIGNING_AUTH_SESSION_HOURS=12
# Explicit local-only development bypass (never use for hosting):
# SIGNING_AUTH_MODE=local
