SIGNING_AUTH_MODE=google
SIGNING_APP_BASE_URL=https://agreements.belloentertainment.com
SIGNING_EMAIL_BASE_URL=https://agreements.belloentertainment.com
SIGNING_AUTH_SESSION_HOURS=12
SIGNING_MODE=google
# Start with local delivery for staging. Switch to gmail after validation.
SIGNING_EMAIL_MODE=local
SIGNING_SIGNING_TIMEZONE=America/New_York
SIGNING_DATA_DIR=/var/lib/bello-signing
SIGNING_TEMPLATE_FOLDER_ID=REPLACE_WITH_CURRENT_TEMPLATE_FOLDER_ID
SIGNING_CONTRACTS_FOLDER_ID=REPLACE_WITH_CURRENT_AGREEMENTS_FOLDER_ID
# Preserve the current setting if vendor alerts go to a specific address:
# SIGNING_VENDOR_EMAIL=
